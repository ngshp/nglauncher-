<Window x:Class="NgpbLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="NGPB Launcher" 
        Height="650" Width="1000"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <!-- Border Utama dengan Efek Kaca (Glass Effect) -->
    <Border CornerRadius="15" BorderBrush="#33ffffff" BorderThickness="1" Background="#cc0a0a14">
        <Grid>
            <!-- Header / Title Bar Custom -->
            <Grid Height="40" VerticalAlignment="Top" Background="#1a0a2e" MouseDown="TitleBar_MouseDown">
                <TextBlock Text="NGPB LAUNCHER v1.2.0 [SECURED]" Foreground="White" 
                           VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="_" Width="40" Height="40" Click="Minimize_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White"/>
                    <Button Content="X" Width="40" Height="40" Click="Close_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="#ff3b3b"/>
                </StackPanel>
            </Grid>

            <!-- Konten Utama -->
            <Grid Margin="0,40,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/> <!-- Panel Kiri (News & Play) -->
                    <ColumnDefinition Width="1*"/> <!-- Panel Kanan (Status & Menu) -->
                </Grid.ColumnDefinitions>

                <!-- PANEL KIRI -->
                <Grid Grid.Column="0" Margin="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="Assets/logo.png" Height="150" Margin="0,0,0,30" Stretch="Uniform"/>
                        
                        <!-- Tombol PLAY Besar -->
                        <Button x:Name="PlayButton" Content="PLAY NOW" 
                                Height="60" Width="300" FontSize="20" FontWeight="Bold"
                                Background="#0066cc" Foreground="White" BorderThickness="0"
                                Click="PlayButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#0088ff"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="border" Property="Background" Value="#555555"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        
                        <TextBlock x:Name="UpdateStatus" Text="Checking for updates..." 
                                   Foreground="#00ff88" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- PANEL KANAN -->
                <Grid Grid.Column="1" Background="#11111a" Margin="0,0,0,0">
                    <StackPanel Margin="20">
                        <TextBlock Text="SERVER STATUS" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <!-- Status Login Server -->
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Ellipse Width="10" Height="10" Fill="#00ff88" Margin="0,0,10,0"/>
                            <TextBlock Text="Login Server: ONLINE" Foreground="#aaa"/>
                        </StackPanel>

                        <!-- Status Game Server -->
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <Ellipse Width="10" Height="10" Fill="#00ff88" Margin="0,0,10,0"/>
                            <TextBlock Text="Game Server: ONLINE" Foreground="#aaa"/>
                        </StackPanel>

                        <Separator Margin="0,20" Background="#333"/>

                        <TextBlock Text="MENU" FontSize="16" FontWeight="Bold" Margin="0,15,0,15"/>
                        <Button Content="Account Settings" Height="40" Margin="0,5" Background="#2a2a3e" Foreground="White" BorderThickness="0"/>
                        <Button Content="Game Settings" Height="40" Margin="0,5" Background="#2a2a3e" Foreground="White" BorderThickness="0"/>
                        <Button Content="Exit Launcher" Height="40" Margin="0,5" Background="#2a2a3e" Foreground="#ff3b3b" BorderThickness="0" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- System Tray Icon (Hidden by default, shows in taskbar area) -->
            <tb:TaskbarIcon x:Name="NotifyIcon" 
                            IconSource="Assets/ngpb_launcher.ico" 
                            ToolTipText="NGPB Launcher is running"
                            LeftClickCommand="{Binding ShowWindowCommand}"
                            Visibility="Visible"/>
        </Grid>
    </Border>
</Window>
