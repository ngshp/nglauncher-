<Window x:Class="NgpbLauncher.Views.SecureBootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NGPB Secure Boot"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="#000000"
        Topmost="True" 
        ResizeMode="NoResize" 
        Width="1920" 
        Height="1080" 
        WindowStartupLocation="CenterScreen">

    <!-- Background Gradient Gelap -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0a0a14" Offset="0"/>
                <GradientStop Color="#1a0a2e" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Konten Utama di Tengah -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
            
            <!-- Logo NGPB -->
            <TextBlock Text="NGPB" 
                       FontSize="72" 
                       FontWeight="Bold" 
                       Foreground="#ff3b3b" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"
                       FontFamily="Arial Black"/>

            <!-- Judul Validasi -->
            <TextBlock Text="ENTERPRISE SECURITY VALIDATION" 
                       FontSize="18" 
                       Foreground="#888888" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,40" 
                       LetterSpacing="4"
                       FontFamily="Consolas"/>

            <!-- Progress Bar Container -->
            <Border CornerRadius="4" Background="#1a1a2e" Height="6" Margin="0,0,0,15" Width="500">
                <ProgressBar x:Name="SecurityProgressBar" 
                             Height="6" 
                             Minimum="0" 
                             Maximum="100" 
                             Value="0" 
                             Background="Transparent" 
                             Foreground="#00ff88" 
                             BorderThickness="0"/>
            </Border>

            <!-- Status Text Real-time -->
            <TextBlock x:Name="StatusText" 
                       Text="Initializing Security Protocols..." 
                       FontSize="14" 
                       Foreground="#aaaaaa" 
                       HorizontalAlignment="Center" 
                       FontFamily="Consolas"/>

            <!-- Peringatan Bawah -->
            <TextBlock Text="DO NOT CLOSE OR MODIFY THIS WINDOW" 
                       FontSize="10" 
                       Foreground="#ff3b3b" 
                       HorizontalAlignment="Center" 
                       Margin="0,60,0,0" 
                       Opacity="0.7"
                       FontFamily="Consolas"/>
        </StackPanel>

        <!-- Overlay Pelanggaran (Awalnya Tersembunyi) -->
        <Grid x:Name="ViolationOverlay" Visibility="Collapsed" Background="#aa000000">
            <Border Background="#1a0000" CornerRadius="10" Padding="40" Width="500" BorderBrush="#ff3b3b" BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="⚠ SECURITY VIOLATION DETECTED" 
                               FontSize="24" 
                               Foreground="#ff3b3b" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ViolationReasonText" 
                               Text="" 
                               FontSize="14" 
                               Foreground="#ffffff" 
                               Margin="0,20,0,0" 
                               TextWrapping="Wrap" 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <Button Content="EXIT" 
                            Width="100" 
                            Height="30" 
                            Margin="0,30,0,0" 
                            Background="#ff3b3b" 
                            Foreground="White" 
                            BorderThickness="0"
                            Click="ExitButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
