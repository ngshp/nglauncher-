<Application x:Class="NgpbLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    
    <Application.Resources>
        <!-- === PALET WARNA ENTERPRISE NGPB === -->
        <SolidColorBrush x:Key="PrimaryRed" Color="#ff3b3b"/>
        <SolidColorBrush x:Key="SecondaryDark" Color="#1a1a2e"/>
        <SolidColorBrush x:Key="BackgroundBlack" Color="#0a0a14"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00ff88"/>
        <SolidColorBrush x:Key="TextGray" Color="#aaaaaa"/>
        <SolidColorBrush x:Key="TextWhite" Color="#ffffff"/>

        <!-- === GLOBAL FONT SETTINGS === -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhite}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
